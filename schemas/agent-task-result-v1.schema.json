{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P002 agent task result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "job_id", "agent_id", "status", "input_hashes", "output_artifacts", "gates", "created_at"],
  "properties": {
    "schema": {"const": "agent-task-result-v1"},
    "job_id": {"type": "string", "minLength": 1},
    "agent_id": {"enum": ["00", "01", "02", "03", "04", "08", "09"]},
    "status": {"enum": ["completed", "revise", "blocked", "failed"]},
    "input_hashes": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "output_artifacts": {"type": "array", "items": {"type": "string"}},
    "gates": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string", "format": "date-time"},
    "failure_code": {"type": "string"}
  }
}
