{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wcb.local/schemas/revision-brief-v1.schema.json",
  "title": "P002 Revision Brief v1",
  "type": "object",
  "required": ["schema", "job_id", "article_id", "attempt", "evaluation_hash", "article_hash", "status", "issues"],
  "properties": {
    "schema": {"const": "revision-brief-v1"}, "job_id": {"type": "string", "minLength": 1}, "article_id": {"type": "string", "minLength": 1},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 3}, "evaluation_hash": {"$ref": "#/$defs/hash"}, "article_hash": {"$ref": "#/$defs/hash"},
    "status": {"enum": ["REVISION_REQUIRED", "ESCALATE_FOR_REVIEW"]}, "issues": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/finding"}}
  },
  "additionalProperties": false,
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "finding": {"type": "object", "required": ["priority", "criterion", "location", "issue", "evidence", "why_it_matters", "how_to_fix", "owner"], "properties": {"priority": {"enum": ["HIGH", "MEDIUM", "LOW"]}, "criterion": {"type": "string", "minLength": 1}, "location": {"type": "string", "minLength": 1}, "issue": {"type": "string", "minLength": 1}, "evidence": {"type": "string", "minLength": 1}, "why_it_matters": {"type": "string", "minLength": 1}, "how_to_fix": {"type": "string", "minLength": 1}, "owner": {"enum": ["AGENT_00", "AGENT_01", "AGENT_02", "AGENT_03", "AGENT_04", "AGENT_06", "AGENT_07", "AGENT_08", "AGENT_09", "AGENT_10", "LEAD"]}}, "additionalProperties": false}
  }
}
