{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wcb.local/schemas/article-voice-v1.schema.json",
  "title": "WCB Public Article Pack v3.2 (Voice v1)",
  "description": "โครงของ public/article.json ที่ tools/article_builder.py ผลิต — เป็น evidence pack ที่ validator ใช้ตรวจเลขปัดกลับค่าดิบตาม WCB Voice Spec v1 · v3.2: ทุกข้อความ/ชื่อ field ที่ผู้อ่านเห็นเป็นภาษาคน (ไม่มีคำ denylist) — รายละเอียดเทคนิคของระดับย้ายไป internal/level-map.json",
  "type": "object",
  "required": ["contract", "schema_version", "voice_spec", "batch_id", "instrument", "headline", "snapshot", "move", "drivers", "technical", "levels", "sr_block", "context", "visuals"],
  "properties": {
    "contract": {"const": "WCB Daily Output Contract v3.1 (Voice v1)"},
    "schema_version": {"const": "3.2.0"},
    "voice_spec": {"type": "string"},
    "batch_id": {"type": "string"},
    "instrument": {
      "type": "object",
      "required": ["symbol", "instrument_type", "block_label", "unit", "cutoff_at", "cutoff_public", "candle_state", "public_timezone"],
      "properties": {
        "symbol": {"type": "string"},
        "instrument_type": {"enum": ["forex_spot", "crypto_spot", "spot_metal"]},
        "instrument_label": {"type": "string"},
        "block_label": {"type": "string", "description": "ชื่อเต็มหัวบล็อกช่วง ④ เช่น EUR/USD (Euro/US Dollar)"},
        "unit": {"type": "string"},
        "decimals": {"type": "integer"},
        "cutoff_at": {"type": "string", "format": "date-time"},
        "cutoff_public": {"type": "string", "description": "เวลาแบบคนอ่าน เช่น 3 ส.ค. 2026 เวลา 17:09 น. (เวลาไทย)"},
        "candle_state": {"enum": ["forming", "closed"]},
        "public_timezone": {"type": "string"}
      }
    },
    "headline": {"type": "string", "description": "หัวเรื่อง ≤12 คำ ไม่มีศัพท์รหัส"},
    "snapshot": {
      "type": "object",
      "required": ["price", "open", "high", "low", "valid_completed_bars"],
      "properties": {
        "price": {"type": "number"},
        "previous_close": {"type": ["number", "null"]},
        "change": {"type": ["number", "null"]},
        "percent": {"type": ["number", "null"]},
        "change_magnitude": {"type": ["number", "null"], "description": "ขนาด change ที่บทความแสดง — ห้าม template คำนวณใหม่"},
        "percent_magnitude": {"type": ["number", "null"]},
        "open": {"type": "number"},
        "high": {"type": "number"},
        "low": {"type": "number"},
        "valid_completed_bars": {"type": "integer"}
      }
    },
    "move": {
      "type": "object",
      "required": ["direction", "class"],
      "properties": {
        "direction": {"enum": ["up", "down", "flat", "unknown"]},
        "class": {"enum": ["quiet", "normal", "strong", "unknown"], "description": "ตาราง 2.6 ของ spec — กำหนดกลุ่มกริยาที่อนุญาต"}
      }
    },
    "drivers": {
      "type": "object",
      "required": ["verified_news", "causal_claims_allowed"],
      "properties": {
        "verified_news": {"type": "array", "description": "ระยะ 1 ต้องว่างเสมอ — ช่วง ② ตัดเงียบ"},
        "causal_claims_allowed": {"type": "boolean"}
      }
    },
    "technical": {
      "type": "object",
      "description": "ชื่อกลางฝั่ง public (sma/atr เป็นคำ denylist) — ค่า atr14 และเครื่องมือที่ไม่พร้อมอยู่ internal/technical.evidence.json",
      "properties": {
        "ma20": {"type": ["number", "null"]},
        "ma50": {"type": ["number", "null"]},
        "rsi14": {"type": ["number", "null"]},
        "timeframes_available": {"type": "array", "items": {"type": "string"}}
      }
    },
    "levels": {
      "type": "array",
      "description": "เฉพาะ field ที่ผู้อ่านใช้ — id เป็นรหัสกลาง level-XX, label เป็นภาษาคนตามบทบาท · ที่มา/วิธีคำนวณอยู่ internal/level-map.json",
      "items": {
        "type": "object",
        "required": ["id", "label", "role"],
        "properties": {
          "id": {"type": "string", "pattern": "^level-\\d{2}$"},
          "label": {"type": "string"},
          "value": {"type": ["number", "null"]},
          "zone_low": {"type": ["number", "null"]},
          "zone_high": {"type": ["number", "null"]},
          "timeframe": {"type": "string"},
          "role": {"enum": ["support", "resistance"]}
        }
      }
    },
    "sr_block": {
      "type": "object",
      "description": "บล็อกช่วง ④ — v1.1 จบที่บรรทัดแนวต้าน ไม่มี note/disclaimer ฝั่ง public อีก (ข้อความเดิมอยู่ internal/qa-report.json → omitted_public_lines)",
      "required": ["supports", "resistances"],
      "properties": {
        "supports": {"$ref": "#/$defs/block_side"},
        "resistances": {"$ref": "#/$defs/block_side"}
      },
      "not": {"required": ["note"]}
    },
    "context": {
      "type": "object",
      "description": "หลักฐานเชิงบริบทของ v1.1 — คำนวณในชั้น pipeline (tools/article_builder.narrative_context) แล้วสำเนาไว้ที่ internal/technical.evidence.json ด้วย · ย่อหน้าขยายของบทความเล่าได้เฉพาะค่าที่อยู่ในก้อนนี้",
      "required": ["streak", "ranges", "moving_average", "volatility", "levels"],
      "properties": {
        "closed_bars_used": {"type": "integer"},
        "streak": {
          "type": "object",
          "description": "จำนวนวันทำการที่ปิดไปทางเดียวกันติดต่อกัน",
          "properties": {
            "direction": {"enum": ["up", "down", null]},
            "days": {"type": ["integer", "null"]},
            "last_date": {"type": ["string", "null"]}
          }
        },
        "ranges": {
          "type": "object",
          "description": "กรอบราคาช่วงสั้น (20 วันทำการ) และช่วงยาว (60 วันทำการ)",
          "properties": {
            "short": {"$ref": "#/$defs/range_window"},
            "long": {"$ref": "#/$defs/range_window"}
          }
        },
        "moving_average": {
          "type": "object",
          "properties": {
            "entries": {
              "type": "object",
              "description": "ma20/ma50 — ฝั่งของราคา ระยะห่างเป็น % และความชันของเส้น",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "period": {"type": "integer"},
                  "price_side": {"enum": ["above", "below", "at"]},
                  "distance_percent": {"type": "number"},
                  "slope": {"enum": ["up", "down", "flat", null]},
                  "slope_lookback": {"type": "integer"},
                  "slope_reference_date": {"type": ["string", "null"]}
                }
              }
            },
            "structure": {"enum": ["short_above_long", "short_below_long", "aligned", null]}
          }
        },
        "volatility": {
          "type": ["object", "null"],
          "properties": {
            "window": {"type": "integer"},
            "today_range": {"type": "number"},
            "average_range": {"type": "number"},
            "today_range_percent": {"type": "number"},
            "average_range_percent": {"type": "number"},
            "comparison": {"enum": ["wider", "narrower", "similar"]}
          }
        },
        "levels": {
          "type": "object",
          "properties": {
            "support_distance_percent": {"type": ["number", "null"]},
            "resistance_distance_percent": {"type": ["number", "null"]},
            "band_position": {"enum": ["lower", "middle", "upper", null]},
            "band_position_percent": {"type": ["number", "null"]}
          }
        }
      }
    },
    "visuals": {"type": "object", "description": "metadata กราฟจาก chart_renderer — กราฟต้องอยู่ทุกฉบับ (คำตัดสิน CC ข้อ 4)"},
    "attribution_required": {"type": "array"}
  },
  "$defs": {
    "range_window": {
      "type": ["object", "null"],
      "description": "จุดสูงสุด/ต่ำสุดของช่วง N วันทำการ พร้อมวันที่ และระยะห่างของราคาปัจจุบันเป็น %",
      "required": ["window", "high", "low"],
      "properties": {
        "window": {"type": "integer"},
        "high": {"type": "number"},
        "high_date": {"type": "string"},
        "low": {"type": "number"},
        "low_date": {"type": "string"},
        "price_side_high": {"enum": ["above", "below", "at"]},
        "price_side_low": {"enum": ["above", "below", "at"]},
        "percent_from_high": {"type": ["number", "null"]},
        "percent_from_low": {"type": ["number", "null"]}
      }
    },
    "block_side": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["level_id", "raw", "text"],
        "properties": {
          "level_id": {"type": "string"},
          "raw": {"type": "number", "description": "ค่าดิบจาก level map — ที่มาของ text"},
          "text": {"type": "string", "description": "ข้อความที่บทความแสดง = round_half_up(raw) ตามกติกาชนิดสินทรัพย์"}
        }
      }
    }
  },
  "additionalProperties": true
}
