{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P002 agent identity v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "agent_id", "identity_version", "name", "mission", "soul", "decision_style", "voice", "boundaries", "examples", "self_check"],
  "properties": {
    "schema": {"const": "agent-identity-v1"},
    "agent_id": {"enum": ["00", "01", "02", "03", "04", "05", "06", "07", "08", "09"]},
    "identity_version": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "mission": {"type": "string", "minLength": 1},
    "soul": {"type": "object", "additionalProperties": false, "required": ["values", "uncertainty", "non_negotiables"], "properties": {"values": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "uncertainty": {"type": "string", "minLength": 1}, "non_negotiables": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
    "decision_style": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "voice": {"type": "object", "additionalProperties": false, "required": ["tone", "sentence_rhythm", "certainty"], "properties": {"tone": {"type": "string"}, "sentence_rhythm": {"type": "string"}, "certainty": {"type": "string"}}},
    "boundaries": {"type": "object", "additionalProperties": false, "required": ["can_do", "must_not_do", "handoff_when"], "properties": {"can_do": {"type": "array", "items": {"type": "string"}}, "must_not_do": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "handoff_when": {"type": "array", "items": {"type": "string"}}}},
    "examples": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["kind", "text", "reason"], "properties": {"kind": {"enum": ["approved", "rejected"]}, "text": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}}}},
    "self_check": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
