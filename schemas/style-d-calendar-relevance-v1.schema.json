{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "style-d-calendar-relevance-v1.schema.json",
  "title": "Style D calendar relevance registry",
  "type": "object",
  "required": ["schema", "version", "assets", "matching", "direction_rules", "families"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "style-d-calendar-relevance-v1"},
    "version": {"type": "string", "minLength": 1},
    "assets": {
      "type": "array", "uniqueItems": true, "minItems": 8,
      "items": {"enum": ["xauusd", "eurusd", "gbpusd", "btcusd", "nvda", "usdthb", "solusd", "wtiusd"]}
    },
    "matching": {
      "type": "object",
      "required": ["allowed_impacts", "unknown_policy", "alias_mode", "single_page", "page_row_units", "title_wrap_columns"],
      "properties": {
        "allowed_impacts": {"const": ["High", "Medium"]},
        "unknown_policy": {"const": "exclude"},
        "alias_mode": {"const": "exact_nfkc_casefold_collapse_space"},
        "single_page": {"const": true},
        "page_row_units": {"type": "integer", "minimum": 1},
        "title_wrap_columns": {"type": "integer", "minimum": 20}
      },
      "additionalProperties": false
    },
    "direction_rules": {
      "type": "object",
      "propertyNames": {"enum": ["xauusd", "eurusd", "gbpusd", "btcusd", "nvda", "usdthb", "solusd", "wtiusd"]},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {"enum": ["higher_positive", "higher_negative"]}
      }
    },
    "families": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "country", "source_ids", "title_en_exact", "assets"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "country": {"type": "string", "minLength": 3, "maxLength": 3},
          "source_ids": {"type": "array", "items": {"type": "string"}},
          "title_en_exact": {"type": "array", "items": {"type": "string"}},
          "assets": {
            "type": "object",
            "additionalProperties": {
              "type": "array", "prefixItems": [
                {"enum": ["direct", "indirect"]}, {"type": "string", "minLength": 1}
              ], "items": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  }
}
