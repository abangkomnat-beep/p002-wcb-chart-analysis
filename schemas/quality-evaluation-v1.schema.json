{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wcb.local/schemas/quality-evaluation-v1.schema.json",
  "title": "P002 Quality Evaluation v1",
  "type": "object",
  "required": ["schema", "job_id", "article_id", "attempt", "producer", "rubric_version", "input_hashes", "hard_gates", "brief_compliance", "visual_applicability", "criterion_judgments", "calculation", "status", "findings", "created_at"],
  "properties": {
    "schema": {"const": "quality-evaluation-v1"},
    "job_id": {"type": "string", "minLength": 1},
    "article_id": {"type": "string", "minLength": 1},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 3},
    "producer": {"const": "agent-05-article-qa"},
    "rubric_version": {"type": "string", "minLength": 1},
    "input_hashes": {
      "type": "object", "required": ["article", "brief", "evidence"],
      "properties": {"article": {"$ref": "#/$defs/hash"}, "brief": {"$ref": "#/$defs/hash"}, "evidence": {"$ref": "#/$defs/hash"}},
      "additionalProperties": false
    },
    "hard_gates": {"type": "object", "required": ["passed", "failures"], "properties": {"passed": {"type": "boolean"}, "failures": {"type": "array", "items": {"type": "string", "minLength": 1}}}, "additionalProperties": false},
    "brief_compliance": {"type": "object", "required": ["passed", "missing"], "properties": {"passed": {"type": "boolean"}, "missing": {"type": "array", "items": {"type": "string", "minLength": 1}}}, "additionalProperties": false},
    "visual_applicability": {"enum": ["content_only", "optional_attached", "required_attached", "required_missing"]},
    "criterion_judgments": {"type": "object", "additionalProperties": {"$ref": "#/$defs/judgment"}},
    "calculation": {
      "type": ["object", "null"],
      "properties": {"content_score": {"$ref": "#/$defs/score"}, "visual_score": {"anyOf": [{"$ref": "#/$defs/score"}, {"type": "null"}]}, "overall_score": {"$ref": "#/$defs/score"}},
      "required": ["content_score", "visual_score", "overall_score"], "additionalProperties": false
    },
    "status": {"enum": ["BLOCK_HARD_GATE", "BRIEF_INCOMPLETE", "REVISION_REQUIRED", "PASS_SCORE", "ESCALATE_FOR_REVIEW"]},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false,
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "score": {"type": "number", "minimum": 0, "maximum": 100},
    "judgment": {"type": "object", "required": ["score", "evidence"], "properties": {"score": {"$ref": "#/$defs/score"}, "evidence": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "finding": {"type": "object", "required": ["priority", "criterion", "location", "issue", "evidence", "why_it_matters", "how_to_fix", "owner"], "properties": {"priority": {"enum": ["HIGH", "MEDIUM", "LOW"]}, "criterion": {"type": "string", "minLength": 1}, "location": {"type": "string", "minLength": 1}, "issue": {"type": "string", "minLength": 1}, "evidence": {"type": "string", "minLength": 1}, "why_it_matters": {"type": "string", "minLength": 1}, "how_to_fix": {"type": "string", "minLength": 1}, "owner": {"enum": ["AGENT_00", "AGENT_01", "AGENT_02", "AGENT_03", "AGENT_04", "AGENT_06", "AGENT_07", "AGENT_08", "AGENT_09", "AGENT_10", "LEAD"]}}, "additionalProperties": false}
  }
}
